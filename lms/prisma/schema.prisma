generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STUDENT
}

enum WorkshopStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RESUBMITTED
}

enum ModerationStatus {
  APPROVED
  FLAGGED
  PENDING
}

enum AiProvider {
  CLAUDE
  GEMINI
  KIMI
  OPENAI
  DEFAULT
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  emailVerified  DateTime?
  password       String?
  image          String?
  role           Role     @default(STUDENT)
  githubUsername String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  workshopRoles      UserRole[]
  createdWorkshops   Workshop[]       @relation("CreatedWorkshops")
  createdAssignments Assignment[]     @relation("CreatedAssignments")
  submissions        Submission[]
  progress           Progress[]
  forumTopics        ForumTopic[]
  forumPosts         ForumPost[]
  certificates       Certificate[]
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  workshopId String
  role       Role     @default(STUDENT)
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId])
  @@index([workshopId, role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workshop {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  description String?
  validUntil  DateTime?
  status      WorkshopStatus @default(ACTIVE)
  aiProvider  AiProvider     @default(DEFAULT)
  aiApiKey    String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy           User                 @relation("CreatedWorkshops", fields: [createdById], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  assignments         Assignment[]
  forumTopics         ForumTopic[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?

  @@index([status])
  @@index([createdById])
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String   @db.Text
  videoUrl    String?
  difficulty  String   @default("beginner")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]
  progress    Progress[]
}

model Assignment {
  id                String    @id @default(cuid())
  workshopId        String?
  title             String
  description       String
  instructions      String    @db.Text
  tutorialId        String?
  dueDate           DateTime?
  maxMarks          Int
  allowResubmission Boolean   @default(true)
  enableAiGrading   Boolean   @default(true)
  attachments       String[]  @default([])
  published         Boolean   @default(false)
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workshop    Workshop?    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  tutorial    Tutorial?    @relation(fields: [tutorialId], references: [id])
  createdBy   User         @relation("CreatedAssignments", fields: [createdById], references: [id], onDelete: Restrict)
  submissions Submission[]
  forumTopics ForumTopic[]

  @@index([workshopId])
  @@index([dueDate])
  @@index([deletedAt])
}

model Submission {
  id            String           @id @default(cuid())
  userId        String
  assignmentId  String
  version       Int              @default(1)
  repoUrl       String?
  deploymentUrl String?
  driveUrl      String?
  branch        String           @default("main")
  fileUrls      String[]         @default([])
  comments      String?          @db.Text
  status        SubmissionStatus @default(SUBMITTED)
  isGradePublished Boolean       @default(false)
  deletedAt     DateTime?
  submittedAt   DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  functionalityScore Float?
  qualityScore       Float?
  aiDetectionScore   Float?
  totalScore         Float?
  feedback           String? @db.Text
  aiSuggestedScore   Float?
  aiSuggestedFeedback String? @db.Text

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId, version])
  @@index([assignmentId, userId])
  @@index([status])
  @@index([deletedAt])
}

model Progress {
  id         String   @id @default(cuid())
  userId     String
  tutorialId String
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  tutorial Tutorial @relation(fields: [tutorialId], references: [id])

  @@unique([userId, tutorialId])
}

model ForumTopic {
  id          String   @id @default(cuid())
  workshopId  String
  assignmentId String?
  title       String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop   Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  posts      ForumPost[]

  @@index([workshopId])
  @@index([assignmentId])
}

model ForumPost {
  id               String           @id @default(cuid())
  topicId          String
  userId           String
  content          String           @db.Text
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
}

model CertificateTemplate {
  id          String   @id @default(cuid())
  workshopId  String   @unique
  templateUrl String
  nameX       Int      @default(300)
  nameY       Int      @default(400)
  fontSize    Int      @default(36)
  createdAt   DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
}

model Certificate {
  id             String   @id @default(cuid())
  workshopId     String
  userId         String
  certificateUrl String
  issuedAt       DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([userId])
}
