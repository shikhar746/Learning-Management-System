generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  emailVerified      DateTime?
  image              String?
  role               Role          @default(STUDENT)
  githubUsername     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  password           String?
  accounts           Account[]
  createdAssignments Assignment[]  @relation("CreatedAssignments")
  certificates       Certificate[]
  forumPosts         ForumPost[]
  forumTopics        ForumTopic[]

  sessions           Session[]
  submissions        Submission[]
  workshopRoles      UserRole[]
  createdWorkshops   Workshop[]    @relation("CreatedWorkshops")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  workshopId String
  role       Role     @default(STUDENT)
  joinedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId])
  @@index([workshopId, role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workshop {
  id                  String               @id @default(cuid())
  name                String
  code                String               @unique
  description         String?
  validUntil          DateTime?
  status              WorkshopStatus       @default(ACTIVE)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiApiKey            String?
  aiProvider          AiProvider           @default(DEFAULT)
  assignments         Assignment[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?
  forumTopics         ForumTopic[]
  userRoles           UserRole[]
  createdBy           User                 @relation("CreatedWorkshops", fields: [createdById], references: [id])

  @@index([status])
  @@index([createdById])
}



model Assignment {
  id                String       @id @default(cuid())
  title             String
  description       String
  instructions      String

  dueDate           DateTime?
  maxMarks          Int
  allowResubmission Boolean      @default(true)
  attachments       String[]     @default([])
  published         Boolean      @default(false)
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  enableAiGrading   Boolean      @default(true)
  workshopId        String?
  createdBy         User         @relation("CreatedAssignments", fields: [createdById], references: [id])

  workshop          Workshop?    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  forumTopics       ForumTopic[]
  submissions       Submission[]

  @@index([workshopId])
  @@index([dueDate])
  @@index([deletedAt])
}

model Submission {
  id                  String           @id @default(cuid())
  userId              String
  assignmentId        String
  version             Int              @default(1)
  repoUrl             String?
  deploymentUrl       String?
  branch              String           @default("main")
  fileUrls            String[]         @default([])
  comments            String?
  status              SubmissionStatus @default(SUBMITTED)
  isGradePublished    Boolean          @default(false)
  deletedAt           DateTime?
  submittedAt         DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  functionalityScore  Float?
  qualityScore        Float?
  aiDetectionScore    Float?
  totalScore          Float?
  feedback            String?
  aiSuggestedFeedback String?
  aiSuggestedScore    Float?
  driveUrl            String?
  assignment          Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [userId], references: [id])

  @@unique([userId, assignmentId, version])
  @@index([assignmentId, userId])
  @@index([status])
  @@index([deletedAt])
}



model ForumTopic {
  id           String      @id @default(cuid())
  workshopId   String
  assignmentId String?
  title        String
  description  String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  posts        ForumPost[]
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  createdBy    User        @relation(fields: [createdById], references: [id])
  workshop     Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([assignmentId])
}

model ForumPost {
  id               String           @id @default(cuid())
  topicId          String
  userId           String
  content          String
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  topic            ForumTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
}

model CertificateTemplate {
  id          String   @id @default(cuid())
  workshopId  String   @unique
  templateUrl String
  nameX       Int      @default(300)
  nameY       Int      @default(400)
  fontSize    Int      @default(36)
  createdAt   DateTime @default(now())
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
}

model Certificate {
  id             String   @id @default(cuid())
  workshopId     String
  userId         String
  certificateUrl String
  issuedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop       Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  STUDENT
}

enum WorkshopStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RESUBMITTED
}

enum ModerationStatus {
  APPROVED
  FLAGGED
  PENDING
}

enum AiProvider {
  CLAUDE
  GEMINI
  KIMI
  OPENAI
  DEFAULT
}
