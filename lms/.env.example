# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/lms"

# NextAuth — required for JWT signing/encryption regardless of provider.
# Generate a strong random value, e.g.: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-key"
AUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Cloudinary Storage Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# Optional SMTP Email Notifications Setup
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"LMS Platform" <noreply@lms.com>'
